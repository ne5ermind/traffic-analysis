DATABASE_URL=sqlite:///./data/traffic.db
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./data
DETECTOR=yolo
MODEL_PATH=yolo11n.pt
DEVICE=auto
MAX_UPLOAD_GB=30
# Optional local vision-language second opinion through Ollama.
# On macOS Docker use host.docker.internal; for local uvicorn use 127.0.0.1.
LOCAL_VLM_ENABLED=false
LOCAL_VLM_URL=http://host.docker.internal:11434
LOCAL_VLM_MODEL=qwen3.5:9b
LOCAL_VLM_TIMEOUT=600
LOCAL_VLM_FRAMES=4
# Custom import path, e.g. my_package.detector:MyDetector
# DETECTOR=custom
# CUSTOM_DETECTOR=my_package.detector:MyDetector
# CLASS_MAP={"automobile":"car","human":"pedestrian"}

# DETECTOR=torchscript or onnx: output Nx6 (xyxy, score, class index)
# MODEL_CLASSES=["car","truck","bus","motorcycle","bicycle","pedestrian"]

LOCAL_VLM_SCENE_MODEL=qwen3-vl:8b
